<?xml version="1.0" encoding="UTF-8"?>
<!--
  hitl_default.sdf — Gazebo Harmonic world for HIL (Hardware-in-the-Loop) simulation.

  Spawns x500_hitl model which includes the GZHILBridge plugin.
  GZHILBridge bridges sensor data to a real PX4 board via USB serial or TCP.

  Usage (via make target — recommended):
    make px4_sitl_default gz_x500_hitl

  Manual launch:
    source build/px4_sitl_default/rootfs/gz_env.sh
    mavlink-routerd -e <qgc_ip>:14550 /dev/ttyACM0:921600 &
    gz sim Tools/simulation/gz/worlds/hitl.sdf
-->
<sdf version="1.9">
  <world name="hitl_default">

    <!-- ===================== 1. PHYSICS & GPS COORDINATE ===================== -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <!-- GPS origin: Zurich (same as default.sdf) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- ===================== 2. ENVIRONMENT & LIGHT ===================== -->
    <!-- Sensor system plugins come from Tools/simulation/gz/server.config
         (physics, imu, mag, air-pressure, navsat, sensors-system are all there).
         No need to duplicate them here. -->
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <!-- Sun -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- ===================== 3. WORLD MODELS ===================== -->
    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
      </link>
    </model>
    <!-- Spawn x500_hitl at origin, 0.2m above ground -->
    <include>
      <uri>model://x500_hitl</uri>
      <name>x500_hitl</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
