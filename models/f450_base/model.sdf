      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

      <sensor name="imu_perfect" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      """
      <sensor name="imu_sensor" type="imu">
        <always_on>0</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <!-- <stddev>0.0008726646</stddev> -->
                <stddev>0.0008</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <!-- <stddev>0.0008726646</stddev> -->
                <stddev>0.0008</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <!-- <stddev>0.0008726646</stddev> -->
                <stddev>0.0008</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
            <!-- <stddev>0.00637</stddev> -->
                <stddev>0.0065</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
             <!-- <mean>0.0</mean> -->
                <mean>0.2</mean>
                <stddev>0.0065</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.2</mean>
            <!-- <stddev>0.00686</stddev> -->
                <stddev>0.006</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
       </sensor>

      <!-- GPS the PX4 bridge actually reads: name MUST stay 'navsat_sensor' on base_link.
           Realistic u-blox NEO-M9N model: SMALL white noise (tiny fix-to-fix jitter, like a
           receiver-smoothed output) + a SLOW dynamic bias (Gauss-Markov) for the ~1-2 m
           absolute wander. This passes EKF2's on-ground GPS drift check (which measures
           fix-to-fix rate, not absolute error) while still looking like real GPS.
           UNITS: horizontal position = DEGREES (1 deg ~ 111320 m), vertical = METERS, vel = m/s.
           Dynamic-bias steady-state stddev = dynamic_bias_stddev * sqrt(tau/2), tau = correlation_time. -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>20</update_rate> <!-- M9N max nav rate -->
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0000002</stddev>                         <!-- white ~0.022 m: small fix-to-fix jitter -->
                <dynamic_bias_stddev>0.0000016</dynamic_bias_stddev> <!-- steady ~1.5 m abs (0.0000016*sqrt(75)*111320) -->
                <dynamic_bias_correlation_time>150.0</dynamic_bias_correlation_time> <!-- slow wander, seconds -->
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>                              <!-- white 0.05 m -->
                <dynamic_bias_stddev>0.35</dynamic_bias_stddev>    <!-- steady ~3.0 m abs (0.35*sqrt(75)) -->
                <dynamic_bias_correlation_time>150.0</dynamic_bias_correlation_time>
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>           <!-- m/s, M9N velocity accuracy -->
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.10</stddev>           <!-- m/s, vertical velocity error -->
              </noise>
            </vertical>
          </velocity_sensing>
        </navsat>
      </sensor>

      <!-- Ground-truth GPS: PX4 does NOT read this (different name), no noise. For logging/comparison. -->
      <sensor name="navsat_ground_truth" type="navsat">
        <always_on>1</always_on>
        <update_rate>20</update_rate>
      </sensor>

