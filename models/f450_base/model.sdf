    <!-- UWB anchor include (attached to base_link) -->
    <!-- TODO: temp comment because dont have model://uwb and plugin libuwb_range.so
    <include>
      <uri>model://uwb</uri>
      <name>uwb_tag</name>
     <pose>0 0 -0.06 0 0 0</pose>
     <plugin name="uwb_plugin::UwbRange" filename="libuwb_range.so">
    <variance>0.01</variance>
    </plugin>
    </include>

    <joint name="uwb_joint" type="fixed">
    <parent>base_link</parent>
    <child>uwb_tag::link</child>
    </joint>
    -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/f450/odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>


