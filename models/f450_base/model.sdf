<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='f450_base'>
    <pose>0 0 .15 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02166666666666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02166666666666667</iyy>
          <iyz>0</iyz>
          <izz>0.04000000000000001</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name="base_link_visual">
        <pose>0 0 0.02 0 0 -.125861774</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://f450_base/meshes/F450-base.STL</uri>
          </mesh>
        </geometry>
        <!-- Carbon dark-grey body. NOTE: F450-base.STL has no UV coords, so a texture
             (albedo_map) cannot wrap the body; we use solid PBR colors instead. To get a
             real carbon weave like x500, convert the STL to a UV-mapped .dae. -->
        <material>
          <ambient>0.04 0.04 0.05 1</ambient>
          <diffuse>0.06 0.06 0.07 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr>
            <metal>
              <metalness>0.7</metalness>
              <roughness>0.35</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="base_link_collision_0">
        <pose>0 0 .007 0 0 0</pose>
        <geometry>
          <box>
            <size>0.318 0.318 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
