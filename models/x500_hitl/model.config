<?xml version="1.0"?>
<model>
  <name>x500_hitl</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>PX4 Development Team</name>
  </author>
  <description>
    X500 quadrotor configured for Hardware-in-the-Loop (HIL) simulation with Gazebo Harmonic.
    Motor commands are driven by a real PX4 FMU board via GZHILBridge (USB serial MAVLink).
    No software flight controller runs inside Gazebo — the real board runs the full PX4 stack.
  </description>
</model>
