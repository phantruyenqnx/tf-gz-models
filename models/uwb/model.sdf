    <!-- HELIPAD in Safe Zone + 4 UWB anchors -->
    <model name="helipad">
      <static>true</static>
      <pose>0 0 0.008 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2 2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://uwb/materials/textures/Heliport.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.8</roughness>
              </metal>
