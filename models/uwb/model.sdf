          <material>
            <ambient>0.08 0.28 0.75 1</ambient>
            <diffuse>0.08 0.28 0.75 1</diffuse>
          </material>
        </visual>

        <inertial>
          <mass>1000</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
      </link>
    </model>

