<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- UWB world environment: buildings, trees, roads, soccer field, helipad + UWB anchors.
       Self-contained: heliport texture lives under model://uwb/materials/textures. -->
  <model name="uwb">
    <static>true</static>

    <model name="long_2story_building">
      <static>true</static>
      <pose>7 18 0.01 0 0 0</pose>
