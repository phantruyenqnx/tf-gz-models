    <!-- New blue house: 3 floors, 20x30x30 m -->
    <model name="blue_3floor_house">
      <static>true</static>
      <pose>62 50 0.01 0 0 1.6</pose>
      <link name="body">
        <collision name="collision">
          <pose>0 0 15 0 0 0</pose>
          <geometry><box><size>20 30 30</size></box></geometry>
        </collision>

        <visual name="walls_visual">
