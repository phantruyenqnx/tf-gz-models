      <joint name="joint_0" type="ball">
      <parent>link_attachment</parent>
      <child>link_0</child>
      <pose>0 0 0.06 0 0 0</pose>
      <axis>
        <limit>
          <effort>4500</effort>
          <velocity>50</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.005</friction>
          <spring_stiffness>0</spring_stiffness>
          <spring_reference>0.0</spring_reference>
        </dynamics>
        <!-- Ball joint không cần định nghĩa xyz vì rotate tự do 3 trục -->
      </axis>
      <physics>
        <ode>
          <cfm>0.001</cfm>
          <erp>0.4</erp>
        </ode>
      </physics>
    </joint>
    

    
    
