    <!-- Rotor 0: Front Right (CCW)
    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <!-- TODO: Get exact rotor position from SolidWorks -->
      <pose>0.22 -0.22 0.08 0 0 0</pose>  <!-- PLACEHOLDER position -->
      <inertial>
        <!-- TODO: CRITICAL - Get propeller inertia from SolidWorks -->
        <!-- Select propeller + bell assembly -> Tools -> Mass Properties -->
        <mass>0.025</mass>  <!-- PLACEHOLDER: estimate for 15x5 prop + bell -->
        <inertia>
          <ixx>5.0e-07</ixx>  <!-- PLACEHOLDER -->
          <iyy>3.5e-05</iyy>  <!-- PLACEHOLDER -->
          <izz>3.5e-05</izz>  <!-- PLACEHOLDER -->
        </inertia>
      </inertial>

      <!-- Propeller visual -->
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://Tarot650_base/meshes/prop_15x5_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>

      <!-- Motor bell visual (rotates with prop) -->
      <visual name="rotor_0_visual_motor_bell">
        <pose>0 0 -0.04 0 0 0</pose>  <!-- TODO: Adjust Z offset -->
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://Tarot650_base/meshes/motor_3508_bell.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Propeller collision -->
      <collision name="rotor_0_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <!-- TODO: Measure actual 15x5 prop dimensions -->
            <size>0.38 0.03 0.002</size>  <!-- 15 inch = ~0.38m diameter -->
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
