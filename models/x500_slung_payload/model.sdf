<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_slung_payload'>
    <!-- Disable self-collision for all links in this composite model -->
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>
    <include merge='true'>
      <uri>model://tether_cable</uri>
      <pose relative_to="base_link">0 0 -0.12 0 0 0</pose>
    </include>
    <joint name="tether_attach_base" type="fixed">
      <parent>base_link</parent>
      <child>link_attachment</child>
    </joint>
  </model>
</sdf>

